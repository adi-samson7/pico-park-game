{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-timeout=60000 \"test/*.test.ts\"",
    "test:e2e": "tsx --test --test-concurrency=1 \"test/e2e/*.e2e.ts\""
  },
  "dependencies": {
    "colyseus": "^0.17.10",
    "@colyseus/schema": "^4.0.30",
    "@colyseus/ws-transport": "^0.17.13",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.0",
    "@types/express": "^5.0.5",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "ws": "^8.18.0"
  }
}
