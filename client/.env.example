# Optional. Where the game server lives.
#
# Leave unset for the normal setups:
#   npm run dev      -> http://localhost:2567
#   production build -> the same origin that served the page
#
# Set it to point the client at a server on another host, e.g.
# VITE_SERVER_URL=https://pico-coop.example.com
VITE_SERVER_URL=
